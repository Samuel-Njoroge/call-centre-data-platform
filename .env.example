# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real credentials.
#
# LOCAL PATH (zero cloud dependency): only EXCHANGERATE_API_KEY is required.
# Everything below that is only needed for the PRODUCTION path (Airbyte, S3,
# Redshift, Superset's Redshift connection).

# --- Exchange rate API (required for both paths) ---
# Free key from https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# --- AWS region (production path) ---
AWS_REGION=us-east-1

# --- AWS: raw-data-ingestor (production path -- uploads data/raw/ to S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 bucket (production path) ---
S3_RAW_BUCKET=

# --- Airbyte S3 reader (production path -- Airbyte's S3 source connector) ---
AIRBYTE_S3_ACCESS_KEY_ID=
AIRBYTE_S3_SECRET_ACCESS_KEY=

# --- Airbyte Redshift writer (production path -- Airbyte's Redshift destination) ---
AIRBYTE_REDSHIFT_ACCESS_KEY=
AIRBYTE_REDSHIFT_SECRET_ACCESS_KEY=

# --- Redshift (production path) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_AIRBYTE_USER=airbyte_writer
REDSHIFT_AIRBYTE_PASSWORD=
REDSHIFT_DBT_USER=dbt_user
REDSHIFT_DBT_PASSWORD=

# --- Apache Superset's Redshift connection (production path) ---
REDSHIFT_SUPERSET_USER=superset_reader
REDSHIFT_SUPERSET_PASSWORD=

# --- Airbyte local instance (production path -- from `./tools/abctl local credentials`) ---
AIRBYTE_LOGIN_EMAIL=
AIRBYTE_LOGIN_PASSWORD=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# Connection ID for the "S3 raw -> Redshift raw" connection, once created
AIRBYTE_CONNECTION_ID=

# --- Superset (containerized, production path for the Redshift connection) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=admin
